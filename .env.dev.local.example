# Copy to .env.dev.local (git-ignored). Local dev database only, never production.
DB_HOST=127.0.0.1
DB_NAME=solar_dev
DB_USER=solar_dev
DB_PASSWORD=pick-a-dev-password
# From `npm run staff:hash`. Keep the quotes: the value contains ":" and ";".
STAFF_USERS='dev:Dev User:pbkdf2-sha256....'

# Native dev builds only: where the app finds the API. iOS simulator can use
# localhost; a real phone needs this machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE=http://localhost:3000
