# Brylliant Solar - Apache config for Expo Router static export (Hostinger)
# Copied into dist/ at build time by `expo export`.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Index routes inside a folder: /internal -> internal/index.html, no slash redirect
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Serve real files and directories untouched (hashed JS/CSS, images, favicon)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Drop trailing slashes so /book/ and /book resolve to the same page
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Extensionless routes: /book -> book.html, /estimate -> estimate.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# Unknown routes render the Expo not-found screen
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Content-hashed bundles never change: cache them hard
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be revalidated so new deploys are picked up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Staff pages: keep them out of search engines and shared caches. The real
  # gate is the PHP session in api/auth.php, not these headers.
  <If "%{REQUEST_URI} =~ m#^/internal#">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "private, no-store"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Do not let Apache guess /book -> book.html on its own; the rules above own that
Options -MultiViews -Indexes
